ARG INTEL_PYTORCH_IMAGE=intel/pytorch@sha256:dda613c2e1ab34d9630626ffac50d530fe5e2ef5576f6fb68de7b2d360b41cd5
FROM ${INTEL_PYTORCH_IMAGE}

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /opt/rosetta
COPY pyproject.toml README.md LICENSE ./
COPY src ./src

# Keep the project stack aligned with the previously validated CPU image while
# preserving the XPU-enabled torch/torchvision wheels supplied by the base image.
RUN python -m pip install \
        "numpy==2.2.6" \
        "pyarrow==25.0.0" \
        "transformers==5.14.1" \
        "peft==0.20.0" \
        "lerobot[dataset]==0.6.1" \
        "pytest==9.1.1" \
        "ruff==0.16.2" \
    && python -m pip install --no-deps . \
    && python -m pip check \
    && python -c "import torch; assert torch.__version__.endswith('+xpu')"

COPY configs ./configs
COPY scripts ./scripts
COPY tests ./tests

CMD ["bash"]
