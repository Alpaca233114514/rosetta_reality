ARG MOVEIT_IMAGE=rosetta-reality-aloha-moveit2:humble-2.5.9
FROM ${MOVEIT_IMAGE}

ARG PYTORCH_VERSION=2.11.0

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_DEFAULT_TIMEOUT=120 \
    PIP_RETRIES=10 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    MUJOCO_GL=egl

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# Keep planning and simulation in one process namespace.  The base image owns
# the hash-bound official MoveIt 2/OMPL binary; this layer adds only the pinned
# CPU Python runtime needed to replay train-only data and execute MuJoCo.
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    apt-get \
        -o Acquire::Retries=10 \
        -o Acquire::http::Timeout=120 \
        -o Acquire::https::Timeout=120 \
        update \
    && apt-get \
        -o Acquire::Retries=10 \
        -o Acquire::http::Timeout=120 \
        -o Acquire::https::Timeout=120 \
        install --yes --no-install-recommends \
        ca-certificates \
        libegl1 \
        libgl1 \
        libgles2 \
        libglfw3 \
        libosmesa6 \
        python3 \
        python3-pip \
        python3-venv

RUN python3 -m venv /opt/rosetta-eval-venv

RUN --mount=type=cache,target=/root/.cache/pip,sharing=locked \
    /opt/rosetta-eval-venv/bin/python -m pip install \
        "torch==${PYTORCH_VERSION}" \
        --index-url https://download.pytorch.org/whl/cpu

RUN --mount=type=cache,target=/root/.cache/pip,sharing=locked \
    /opt/rosetta-eval-venv/bin/python -m pip install \
        "numpy==2.2.6" \
        "pyarrow==25.0.0" \
        "PyYAML==6.0.3" \
        "gym-aloha==0.1.4" \
        "mujoco==3.8.1" \
        "mink==1.2.0" \
        "qpsolvers==4.13.0" \
        "daqp==0.8.7" \
        "pytest==9.1.1" \
        "ruff==0.16.2"

RUN /opt/rosetta-eval-venv/bin/python -m pip check \
    && /opt/rosetta-eval-venv/bin/python - <<'PY'
from importlib.metadata import version

assert version("torch") == "2.11.0+cpu"
assert version("numpy") == "2.2.6"
assert version("pyarrow") == "25.0.0"
assert version("gym-aloha") == "0.1.4"
assert version("mujoco") == "3.8.1"
assert version("mink") == "1.2.0"
assert version("qpsolvers") == "4.13.0"
assert version("daqp") == "0.8.7"
PY

LABEL org.opencontainers.image.title="Rosetta Reality ALOHA MoveIt 2 simulation evaluator" \
      org.opencontainers.image.description="Pinned train-only MuJoCo evaluation layer over the official MoveIt 2/OMPL sidecar" \
      org.rosetta-reality.source-moveit-image="sha256:a48a28875f358f087fa83f6819c720d66f74e9ff9f3bdb28c8997fcd54f566b2"

ENV PATH=/opt/rosetta-eval-venv/bin:$PATH

WORKDIR /workspace
CMD ["bash"]
