ARG ROS_IMAGE=ros@sha256:7bea3d9aa2483d3ca34c8e30d921b79273b0913bd7dc64bebf51d082b5d107e4
FROM ${ROS_IMAGE}

ARG INTERBOTIX_MANIPULATORS_COMMIT=b66d5b905725351dd71d3251a06cd3f4c777940f
ARG INTERBOTIX_MANIPULATORS_ARCHIVE_SHA256=d22c67bf76a83de275e547f07ed9959bbf5a4335fe0da4ff092efa7094ab7637
ARG MOVEIT_VERSION=2.5.9-1jammy.20260804.232923
ARG MOVEIT_KINEMATICS_VERSION=2.5.9-1jammy.20260804.220521
ARG MOVEIT_OMPL_VERSION=2.5.9-1jammy.20260804.221730
ARG MOVEIT_PLANNING_INTERFACE_VERSION=2.5.9-1jammy.20260804.223930
ARG XACRO_VERSION=2.1.1-1jammy.20260304.195513

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    ROS_DISTRO=humble

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# The local Windows proxy rejects the Ubuntu images' HTTP archive URLs.  HTTPS
# preserves apt signature verification for Ubuntu.  The official ROS image's
# signed packages.ros.org source stays unchanged because the proxy presents a
# mismatched certificate for that host on HTTPS; bounded retries handle its
# occasional HTTP 502 responses without disabling APT signature checks.
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    sed -i \
        -e 's|http://archive.ubuntu.com|https://archive.ubuntu.com|g' \
        -e 's|http://security.ubuntu.com|https://security.ubuntu.com|g' \
        /etc/apt/sources.list \
    && apt-get \
        -o Acquire::Retries=10 \
        -o Acquire::http::Timeout=120 \
        -o Acquire::https::Timeout=120 \
        update \
    && packages=( \
        ca-certificates \
        curl \
        g++ \
        libtinyxml2-dev \
        liburdfdom-tools \
        nlohmann-json3-dev \
        "ros-humble-moveit=${MOVEIT_VERSION}" \
        "ros-humble-moveit-kinematics=${MOVEIT_KINEMATICS_VERSION}" \
        "ros-humble-moveit-planners-ompl=${MOVEIT_OMPL_VERSION}" \
        "ros-humble-moveit-ros-planning-interface=${MOVEIT_PLANNING_INTERFACE_VERSION}" \
        "ros-humble-xacro=${XACRO_VERSION}" \
    ) \
    && for attempt in 1 2 3 4 5; do \
        apt-get \
            -o Acquire::Retries=10 \
            -o Acquire::http::Timeout=120 \
            -o Acquire::https::Timeout=120 \
            -o Binary::apt-get::APT::Keep-Downloaded-Packages=true \
            install --yes --no-install-recommends --fix-missing \
            "${packages[@]}" \
        && break; \
        test "${attempt}" != 5; \
    done

# Keep the official Trossen/Interbotix ALOHA VX300S description immutable in
# the image.  Rosetta composes two copies later; it does not alter this source.
RUN curl --fail --location --retry 5 --retry-delay 2 \
        --output /tmp/interbotix_ros_manipulators.tar.gz \
        "https://codeload.github.com/Interbotix/interbotix_ros_manipulators/tar.gz/${INTERBOTIX_MANIPULATORS_COMMIT}" \
    && echo "${INTERBOTIX_MANIPULATORS_ARCHIVE_SHA256}  /tmp/interbotix_ros_manipulators.tar.gz" \
        | sha256sum --check --strict \
    && mkdir -p /opt/interbotix_ros_manipulators \
    && tar -xzf /tmp/interbotix_ros_manipulators.tar.gz \
        --strip-components=1 \
        -C /opt/interbotix_ros_manipulators \
    && install -d \
        /opt/ros/humble/share/ament_index/resource_index/packages \
        /opt/ros/humble/share/interbotix_xsarm_descriptions \
    && touch \
        /opt/ros/humble/share/ament_index/resource_index/packages/interbotix_xsarm_descriptions \
    && cp -a \
        /opt/interbotix_ros_manipulators/interbotix_ros_xsarms/interbotix_xsarm_descriptions/meshes \
        /opt/interbotix_ros_manipulators/interbotix_ros_xsarms/interbotix_xsarm_descriptions/urdf \
        /opt/ros/humble/share/interbotix_xsarm_descriptions/ \
    && cp \
        /opt/interbotix_ros_manipulators/interbotix_ros_xsarms/interbotix_xsarm_descriptions/package.xml \
        /opt/ros/humble/share/interbotix_xsarm_descriptions/package.xml \
    && rm /tmp/interbotix_ros_manipulators.tar.gz

COPY scripts/compose_aloha_moveit_description.py /opt/rosetta/scripts/
COPY scripts/build_aloha_moveit_description.sh /opt/rosetta/scripts/
COPY integration/aloha_moveit2 /opt/rosetta_ws/src/rosetta_aloha_moveit2

# Generate the planning-only bimanual model from the hash-checked vendor xacro,
# install it with the adapter, and compile the thin process boundary.  The
# planner and IK implementations remain the official MoveIt 2 plugins.
RUN description_root=/tmp/rosetta_aloha_moveit_description \
    && bash /opt/rosetta/scripts/build_aloha_moveit_description.sh "${description_root}" \
    && install -m 0444 \
        "${description_root}/generated/aloha_bimanual.urdf" \
        "${description_root}/generated/aloha_bimanual.srdf" \
        "${description_root}/generated/description_manifest.json" \
        /opt/rosetta_ws/src/rosetta_aloha_moveit2/config/ \
    && set +u \
    && source /opt/ros/humble/setup.bash \
    && set -u \
    && cd /opt/rosetta_ws \
    && colcon build \
        --event-handlers console_direct+ \
        --packages-select rosetta_aloha_moveit2

LABEL org.opencontainers.image.title="Rosetta Reality ALOHA MoveIt 2 planner" \
      org.opencontainers.image.description="Official ROS 2 Humble, MoveIt 2/OMPL, and Interbotix ALOHA VX300S planning base" \
      org.rosetta-reality.ros-distro="humble" \
      org.rosetta-reality.moveit-version="2.5.9" \
      org.rosetta-reality.interbotix-manipulators-commit="b66d5b905725351dd71d3251a06cd3f4c777940f"

ENV RCUTILS_LOGGING_USE_STDOUT=0

WORKDIR /opt/rosetta
CMD ["bash"]
