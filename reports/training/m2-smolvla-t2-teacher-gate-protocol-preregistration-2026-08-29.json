    "note": "a candidate G0 pass is necessary but insufficient; the probe pass only validates the harness"
  },
  "g1": {
    "name": "exact_calibration_reproduction",
    "episode": 2,
    "seed": 10,
    "budget_steps": 500,
    "required_terminal_reward": 4.0,
    "require_success": true,
    "zero_refusals": true,
    "zero_joint_limit_violations": true,
    "zero_unexpected_collisions": true,
    "note": "necessary and insufficient by design; the recovery oracle met this bar on seed 10 only"
  },
  "g2": {
    "name": "cross_pose_generalization",
    "seeds": [1900, 1901, 1902, 1903, 1904],
    "minimum_poses": 5,
    "require_all_solved": true,
    "budget_steps": 500,
    "note": "the criterion the recovery oracle failed 0/1; a single failure fails the gate"
  },
  "g3": {
    "name": "recovery_from_deviated_states",
    "perturbations_per_pose_min": 3,
    "recovery_budget_steps": 150,
    "maximum_refusal_fraction": 0.10,
    "sources": ["registered bounded perturbations of successful trajectories", "completed first-deviation trace states"],
    "safety": {"zero_joint_limit_violations": true, "zero_unexpected_collisions": true},
    "status": "locked_until_g2_pass_and_inventory_registered"
  },
  "g4": {
    "name": "boundary_honesty",
    "zero_silent_defaults": true,
    "status": "locked_until_g2_pass"
  },
  "g5": {
    "name": "independent_audit",
    "recheck_evidence_chain_identity": true
  },
  "seed_boundaries": {
    "opened_by_this_protocol": ["exact episode 2 / seed 10", "tuning seeds 1900-1904"],
    "remain_sealed": ["development 2000-2004", "collection 3000-3004", "policy gate 1000-1004", "hidden test"]
  },
  "boundaries": [
    "a gate pass permits only proposing the next preregistration",
    "no recovery label manifest, no DAgger rollout, no collection seeds, no furnace",
