  "runner": "scripts/run_teacher_gate.py",
  "contract": {
    "observation_type": "rosetta_reality.sim.geometry_teacher.InsertionGeometry",
    "forbidden_inputs": ["wall_clock_or_step_time", "trajectory_or_frame_index", "episode_id", "seed", "dataset_identity", "policy_state"],
    "output": "one absolute standard-space action under the unchanged Action Contract, or one explicit TeacherRefusal",
    "behavior": "deterministic given inputs; fail-closed refusal outside the registered support neighborhood",
    "observation_fields_frozen": true
  },
  "g0": {
    "checks": ["observation_contract_fields_exact", "deterministic_under_replay", "refusal_region_non_degenerate"],
